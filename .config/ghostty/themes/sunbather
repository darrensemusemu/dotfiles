# Mapped Ghostty theme variables
background = #121212
# s:subtle_black (s:bg_very_subtle) for a slightly softer background

foreground = #C6C6C6
# s:lighter_gray (s:norm)

cursor-color = #d75f87
# s:light_pink (s:pink)

cursor-text = #121212
# s:subtle_black


selection-background = #d75f87
# s:light_pink (s:visual)

selection-foreground = #121212
# s:subtle_black (s:norm on dark is lighter_gray, s:norm in visual is also lighter_gray, but this makes it more readable)


# Palette (based on 16-color XTerm palette mapping commonly used, and sunbather's dark colors)
# Standard 8 colors
palette = 0=#121212
# s:subtle_black (black)

palette = 1=#C30771
# s:dark_red (red)

palette = 2=#10A778
# s:dark_green (green)

palette = 3=#A89C14
# s:dark_yellow (yellow)

palette = 4=#005F87
# s:darker_blue (blue)

palette = 5=#ff5f87
# s:dark_pink (magenta, using dark_pink for consistency)

palette = 6=#20A5BA
# s:dark_cyan (cyan)

palette = 7=#A8A8A8
# s:light_gray (white, less bright than F1F1F1)

# Bright 8 colors
palette = 8=#4E4E4E
# s:lighter_black (bright black / dark gray)

palette = 9=#E32791
# s:light_red (bright red)

palette = 10=#5FD7A7
# s:light_green (bright green)

palette = 11=#F3E430
# s:yellow (bright yellow)

palette = 12=#20BBFC
# s:blue (bright blue)

palette = 13=#d75f87
# s:light_pink (bright magenta, using light_pink)

palette = 14=#4FB8CC
# s:light_cyan (bright cyan)

palette = 15=#F1F1F1
# s:white (bright white)

